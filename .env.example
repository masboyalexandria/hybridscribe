# Copy to .env.local — NEVER commit real keys. Firebase web config is not a secret,
# but App Check protects AI Logic calls in production.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
# App Check debug token is accepted for hackathon submissions per official rules.
VITE_APPCHECK_DEBUG_TOKEN=

# reCAPTCHA Enterprise site key for App Check (public — embedded in the web app).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=
